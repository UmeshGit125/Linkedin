# Copy to .env and fill in. Never commit .env.

# AgentRouter key — https://agentrouter.org/console/token
# Used through the Claude Code CLI (model set in config.yaml -> llm.agentrouter_model, currently deepseek-v4).
AGENTROUTER_API_KEY=

# Only for llm.backend: anthropic-api in config.yaml
ANTHROPIC_API_KEY=

# LinkedIn developer app — https://www.linkedin.com/developers/apps
# Products needed: "Share on LinkedIn" + "Sign In with LinkedIn using OpenID Connect"
# Authorized redirect URL must be exactly: http://localhost:8765/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Telegram — create a bot with @BotFather, then run: uv run assistant notify --telegram-setup
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Image generation for posts (optional). Any OpenAI-compatible images endpoint.
IMAGE_API_KEY=
IMAGE_API_BASE=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-1

# Email (optional) — for Gmail use an App Password, not your normal password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=
